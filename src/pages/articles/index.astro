---
import { getCollection } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import { navLinks } from '../../data/siteContent';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Articles — Yannik Peschke" description="Technical articles and notes by Yannik Peschke.">
  <SiteNav logo="Yannik Peschke" links={navLinks} />
  <main id="main-content" tabindex="-1">
    <section class="section-shell articles-page">
      <header class="articles-header">
        <h1>Articles</h1>
        <p class="articles-subtitle">Notes on architecture, engineering platforms, and the teams behind them.</p>
      </header>
      <div class="articles-list">
        {posts.map((post) => (
          <article class="article-row">
            <a href={`/articles/${post.slug}`} class="article-link">
              <div class="article-row-meta">
                <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                <span>{post.data.readTime}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p class="article-row-description">{post.data.description}</p>
              <span class="article-row-read">Read article <span aria-hidden="true">→</span></span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .articles-header {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .articles-eyebrow {
    margin-bottom: 1rem;
    color: var(--color-text-500);
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .articles-eyebrow span {
    color: var(--color-accent);
    margin-right: 0.5rem;
  }

  .articles-header h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .articles-subtitle {
    color: var(--color-text-500);
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .articles-list {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-900);
  }

  .article-row + .article-row {
    border-top: 1px solid var(--color-border);
  }

  .article-link {
    display: block;
    padding: clamp(1.5rem, 3vw, 2rem);
    text-decoration: none;
    transition: background var(--duration-fast);
  }

  .article-link:hover, .article-link:focus-visible {
    background: var(--color-bg-800);
  }

  .article-link:focus-visible {
    outline-offset: -3px;
  }

  .article-row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-600);
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
  }

  .article-link h2 {
    max-width: 48ch;
    margin-bottom: 0.75rem;
    color: var(--color-text-100);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .article-link:hover h2, .article-link:focus-visible h2 {
    color: var(--color-accent);
  }

  .article-row-description {
    max-width: 70ch;
    color: var(--color-text-500);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .article-row-read {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
  }
</style>
