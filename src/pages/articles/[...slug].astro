---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import { navLinks } from '../../data/siteContent';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const articleOutline = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout title={`${post.data.title} — Yannik Peschke`} description={post.data.description}>
  <SiteNav logo="Yannik Peschke" links={navLinks} />

  <main id="main-content" tabindex="-1">
    <article class="section-shell article-page">
      <a href="/articles" class="back-link">← Back to articles</a>

      <header class="article-header">
        <div>
          <p class="article-date">
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
            <span class="article-reading-time">· {post.data.readTime}</span>
          </p>
          <h1>{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
          {
            post.data.tags.length > 0 && (
              <ul class="article-tags" aria-label="Article tags">
                {post.data.tags.map((tag) => (
                  <li class="article-tag">{tag}</li>
                ))}
              </ul>
            )
          }
        </div>
      </header>

      <div class="article-layout">
        {articleOutline.length > 0 && (
          <aside class="article-outline" aria-label="Article contents">
            <details open data-article-outline>
              <summary>On this page <span aria-hidden="true">⌄</span></summary>
              <nav aria-label="On this page">
                <ul class="article-outline-list">
                  {articleOutline.map((heading) => (
                    <li class:list={['article-outline-item', heading.depth === 3 && 'is-subitem']}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </aside>
        )}

        <div class="article-content">
          <Content />

          <footer class="article-disclaimer">
            <p class="article-disclaimer-label">
              <img src="/images/eu-ai-label-black.png" alt="" />
              Use of AI
            </p>
            <p>
              The concepts, opinions, and technical content in this article are my own.
              I use AI tools as part of my editorial process—to help structure the writing, refine phrasing, and make the experience of reading my thoughts as enjoyable as possible.
            </p>
          </footer>
        </div>
      </div>
    </article>
  </main>

  <SiteFooter />
  <script>
    document.querySelectorAll<HTMLElement>('.article-content pre, .article-content table').forEach((element) => {
      element.tabIndex = 0;
    });
    const outline = document.querySelector<HTMLDetailsElement>('[data-article-outline]');
    if (outline) {
      const aboveArticle = window.matchMedia('(max-width: 1100px)');
      const updateOutlineLayout = () => {
        outline.open = !aboveArticle.matches;
      };
      updateOutlineLayout();
      aboveArticle.addEventListener('change', updateOutlineLayout);
    }
  </script>
</BaseLayout>

<style>
  .article-page {
    --prose-size: clamp(1.125rem, 1.05rem + 0.25vw, 1.25rem);
    font-size: var(--prose-size);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
    text-decoration: none;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .article-header h1 {
    margin-bottom: 1.25rem;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .article-description {
    color: var(--color-text-500);
    font-size: 1.25rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    grid-template-areas: 'content outline';
    align-items: start;
    gap: 2.5rem;
  }

  .article-outline {
    grid-area: outline;
    min-width: 0;
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-800);
    font-size: 0.9375rem;
  }

  .article-outline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
    cursor: pointer;
    list-style: none;
  }

  .article-outline summary::-webkit-details-marker {
    display: none;
  }

  .article-outline summary span {
    font-size: 1.125rem;
    line-height: 1;
  }

  .article-outline details[open] summary span {
    transform: rotate(180deg);
  }

  .article-outline nav {
    max-height: calc(100dvh - var(--nav-height) - 7rem);
    overflow-y: auto;
    padding: 0.5rem 1rem 1rem;
    border-top: 1px solid var(--color-border);
    scrollbar-width: thin;
  }

  .article-outline-list {
    list-style: none;
  }

  .article-outline-item a {
    display: block;
    padding: 0.375rem 0;
    color: var(--color-text-500);
    text-decoration: none;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .article-outline-item a:hover, .article-outline-item a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .article-outline-item.is-subitem a {
    padding-left: 0.75rem;
    color: var(--color-text-600);
    font-size: 0.875rem;
  }

  .article-outline-item.is-subitem a:hover {
    color: var(--color-accent);
  }

  .article-content {
    grid-area: content;
    min-width: 0;
    max-width: 68ch;
    color: var(--color-text-200);
    font-size: var(--prose-size);
    line-height: 1.7;
  }

  .article-content :global(h2), .article-content :global(h3), .article-content :global(h4) {
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1.35;
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  .article-content :global(h2) {
    position: relative;
    margin: 3rem 0 1rem;
    padding-left: 1.15em;
    font-size: clamp(1.375rem, 1.1rem + 0.6vw, 1.625rem);
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .article-content :global(h2)::before {
    content: '#';
    position: absolute;
    top: 16px;
    left: 0;
    transform: translateY(-50%);
    color: var(--color-accent);
    line-height: 1;
  }

  .article-content :global(h3) {
    position: relative;
    margin: 2rem 0 0.75rem;
    padding-left: 1.6em;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .article-content :global(h3)::before {
    content: '##';
    position: absolute;
    top: 13px;
    left: 0;
    transform: translateY(-50%);
    color: var(--color-text-600);
    font-size: 0.8em;
    line-height: 1;
  }

  .article-content :global(h4) {
    margin: 1.5rem 0 0.75rem;
    font-size: 1.125rem;
  }

  .article-content > :global(:first-child) {
    margin-top: 0;
  }

  .article-content :global(p) {
    margin-bottom: 1.25rem;
    overflow-wrap: break-word;
  }

  .article-content :global(ul), .article-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5em;
  }

  .article-content :global(li) {
    margin-block: 0.5rem;
    overflow-wrap: break-word;
  }

  .article-content :global(li > p) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(li > ul), .article-content :global(li > ol) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(li::marker) {
    color: var(--color-accent);
  }

  .article-content :global(strong) {
    font-weight: 700;
  }

  .article-content :global(a) {
    overflow-wrap: anywhere;
  }

  .article-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.06);
  }

  .article-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(code) {
    padding: 0.1em 0.3em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-800);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }

  .article-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-800) !important;
    font-size: 0.875rem;
    line-height: 1.75;
    tab-size: 2;
  }

  .article-content :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
    overflow-wrap: normal;
  }

  .article-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .article-content :global(th), .article-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .article-content :global(th) {
    background: var(--color-bg-800);
    font-weight: 600;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: var(--radius-sm);
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .article-disclaimer {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-800);
  }

  .article-disclaimer-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem !important;
    color: var(--color-text-500);
    font-family: var(--font-mono);
    font-size: var(--font-ui-size);
  }

  .article-content .article-disclaimer-label img {
    width: 1.75rem;
    height: 1.75rem;
    margin: 0;
    object-fit: contain;
    filter: invert(1);
    opacity: 0.7;
  }

  .article-disclaimer p:last-child {
    margin-bottom: 0;
    color: var(--color-text-500);
    font-size: 1rem;
    line-height: 1.65;
  }

  @media (max-width: 1100px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'outline' 'content';
      gap: 2rem;
    }

    .article-content {
      max-width: none;
    }

    .article-outline {
      position: static;
    }

    .article-outline nav {
      max-height: 20rem;
    }

    .article-header {
      margin-bottom: 2rem;
    }

  }

  @media (max-width: 640px) {
    .article-description {
      font-size: 1.125rem;
    }

    .article-content :global(pre) {
      padding: 1rem;
    }

    .article-content :global(blockquote), .article-disclaimer {
      padding: 1.25rem;
    }

  }
</style>
